<%# locals: label:, count:, href:, selected: (opcional) %>
<%
  selected = local_assigns[:selected]
  classes = ["sidebar-item"]
  classes << "sidebar-item--active" if selected
%>

<%= link_to href, class: classes.join(" "), aria: { current: (selected ? "page" : nil) } do %>
  <span class="flex items-center gap-2">
    <% if block_given? %>
      <span class="list-item-icon">
        <%= yield %>
      </span>
    <% end %>
    <span class="text-sm font-medium"><%= label %></span>
  </span>
  <%= render "shared/badge", text: count, variant: :neutral %>
<% end %>
