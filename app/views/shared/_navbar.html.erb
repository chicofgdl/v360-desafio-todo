<% has_lists = current_user&.lists&.exists? %>

<header class="app-navbar">
  <div class="app-navbar__content">
    <div class="app-navbar__left">
      <div class="app-navbar__brand" aria-label="V-360">
        <div class="app-navbar__logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
            <path
              d="M7 12.5l3 3 7-7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M5 4h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>
        <span class="app-navbar__brand-name">V-360</span>
      </div>

      <%= render "shared/searchbar", q: params[:q] %>
    </div>

    <div class="app-navbar__right">
      <div class="app-menubar" role="menubar" data-controller="menubar">
        <details class="app-menu" data-menubar-target="menu">
          <summary class="app-menu__trigger" aria-label="Adicionar" data-action="click->menubar#openExclusive">
            <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
              <path
                d="M12 5v14M5 12h14"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
          </summary>
          <div class="app-menu__content" role="menu">
            <div class="app-menu__label">Adicionar</div>
            <button class="app-menu__item"
                    type="button"
                    data-action="click->menubar#closeAll click->list-modal#prepareNew click->modal#open"
                    data-modal-id-param="list-modal">
              Nova lista
            </button>
            <button class="app-menu__item <%= "app-menu__item--disabled" unless has_lists %>"
                    type="button"
                    <%= "disabled" unless has_lists %>
                    aria-disabled="<%= (!has_lists).to_s %>"
                    data-action="click->menubar#closeAll click->task-modal#prepareNew click->modal#open"
                    data-modal-id-param="task-modal">
              Nova tarefa
            </button>
            <% unless has_lists %>
              <div class="app-menu__hint">Crie uma lista antes.</div>
            <% end %>
          </div>
        </details>

        <details class="app-menu" data-menubar-target="menu">
          <summary class="app-menu__trigger" aria-label="Temas" data-action="click->menubar#openExclusive">
            <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
              <path
                d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
              <path
                d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 0 1-1.4 3.4 2 2 0 0 1-1.4-.6l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 0 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 0 1-2.8 0 2 2 0 0 1 0-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 0 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 0 1 0-2.8 2 2 0 0 1 2.8 0l.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.5V3a2 2 0 0 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 0 1 2.8 0 2 2 0 0 1 0 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.5 1H21a2 2 0 0 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </summary>
          <div class="app-menu__content app-menu__content--right" role="menu">
            <div class="app-menu__label">Tema</div>
            <button class="app-menu__item" type="button" data-theme-value="red" data-action="click->menubar#applyTheme">
              <span class="app-swatch app-swatch--red" aria-hidden="true"></span>
              Vermelho
            </button>
            <button class="app-menu__item" type="button" data-theme-value="orange" data-action="click->menubar#applyTheme">
              <span class="app-swatch app-swatch--orange" aria-hidden="true"></span>
              Laranja
            </button>
            <button class="app-menu__item" type="button" data-theme-value="yellow" data-action="click->menubar#applyTheme">
              <span class="app-swatch app-swatch--yellow" aria-hidden="true"></span>
              Amarelo
            </button>
            <button class="app-menu__item" type="button" data-theme-value="green" data-action="click->menubar#applyTheme">
              <span class="app-swatch app-swatch--green" aria-hidden="true"></span>
              Verde
            </button>
            <button class="app-menu__item" type="button" data-theme-value="blue" data-action="click->menubar#applyTheme">
              <span class="app-swatch app-swatch--blue" aria-hidden="true"></span>
              Azul
            </button>
            <button class="app-menu__item" type="button" data-theme-value="purple" data-action="click->menubar#applyTheme">
              <span class="app-swatch app-swatch--purple" aria-hidden="true"></span>
              Roxo
            </button>
            <button class="app-menu__item" type="button" data-theme-value="pink" data-action="click->menubar#applyTheme">
              <span class="app-swatch app-swatch--pink" aria-hidden="true"></span>
              Rosa
            </button>
            <button class="app-menu__item" type="button" data-theme-value="gray" data-action="click->menubar#applyTheme">
              <span class="app-swatch app-swatch--gray" aria-hidden="true"></span>
              Cinza
            </button>
          </div>
        </details>

        <details class="app-menu" data-menubar-target="menu">
          <summary class="app-menu__trigger app-menu__trigger--profile" aria-label="Perfil" data-action="click->menubar#openExclusive">
            <span class="app-menu__avatar"></span>
            <span class="app-menu__user"><%= current_user&.email || "Usuario" %></span>
          </summary>
          <div class="app-menu__content app-menu__content--right" role="menu">
            <div class="app-menu__label">Perfil</div>
            <div class="app-menu__meta"><%= current_user&.email || "usuario@exemplo.com" %></div>
            <div class="app-menu__separator"></div>
            <%= link_to "Sair",
                  destroy_user_session_path,
                  data: { turbo_method: :delete },
                  class: "app-menu__item app-menu__item--danger" %>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
