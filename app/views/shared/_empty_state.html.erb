<%# locals: title:, description:, action_label: (opcional), action_href: (opcional) %>

<div class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-center">
  <h3 class="text-sm font-semibold text-gray-900"><%= title %></h3>
  <p class="mt-1 text-sm text-gray-600"><%= description %></p>

  <% if local_assigns[:action_label].present? && local_assigns[:action_href].present? %>
    <div class="mt-4">
      <%= render "shared/button", label: action_label, href: action_href, variant: :primary %>
    </div>
  <% elsif block_given? %>
    <div class="mt-4">
      <%= yield %>
    </div>
  <% end %>
</div>
