<%
  class_name = local_assigns[:class_name] || local_assigns[:class]
  class_attr = class_name.present? ? " class=\"#{class_name}\"" : ""
  filled = local_assigns.fetch(:filled, false)
  stroke = local_assigns.fetch(:stroke, true)
  stroke_width = local_assigns.fetch(:stroke_width, 2)
%>
<svg viewBox="0 0 24 24" role="img" aria-hidden="true"<%= class_attr %>>
  <path
    d="M12 17.3 6.8 20l1-5.8-4.2-4.1 5.9-.8L12 4l2.5 5.3 5.9.8-4.2 4.1 1 5.8z"
    fill="<%= filled ? "currentColor" : "none" %>"
    <%= "stroke=\"currentColor\"" if stroke %>
    <%= "stroke-width=\"#{stroke_width}\"" if stroke %>
    <%= "stroke-linejoin=\"round\"" if stroke %>
  />
</svg>
