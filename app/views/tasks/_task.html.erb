<div id="<%= dom_id(task) %>" style="margin-left: 18px; display: flex; align-items: center; gap: 10px;">
  <%= form_with url: toggle_list_task_path(task.list, task), method: :patch do %>
    <%= check_box_tag "done", "1", task.done?, onchange: "this.form.requestSubmit()" %>
  <% end %>

  <span style="<%= "text-decoration: line-through; opacity: 0.6;" if task.done? %>">
    <%= task.title %>
  </span>

  <span style="margin-left: auto; display: flex; gap: 10px;">
    <%= link_to "Editar", edit_list_task_path(task.list, task) %>
    <%= button_to "Deletar",
          list_task_path(task.list, task),
          method: :delete,
          data: { turbo_confirm: "Tem certeza?" } %>
  </span>
</div>
