<%
  card_class = "p-3 hover:bg-gray-50 transition"
  card_class += " opacity-70" if task.done?
  title_class = task.done? ? "line-through text-gray-500" : "text-gray-900"

  due_label = nil
  due_class = "task-due"

  if task.due_at.present?
    due_time = task.due_at.in_time_zone
    now = Time.zone.now

    if due_time < now && !task.done?
      due_label = "Atrasada desde #{due_time.strftime("%d/%m/%Y")}"
      due_class = "task-due task-due--overdue"
    elsif due_time.to_date == now.to_date
      due_label = "Para hoje às #{due_time.strftime("%Hh%M")}"
      due_class = "task-due task-due--today"
    elsif due_time > now
      due_label = "Até dia #{due_time.strftime("%d/%m/%Y")}"
      due_class = "task-due task-due--soon"
    else
      due_label = "Venceu em #{due_time.strftime("%d/%m/%Y")}"
    end
  end
%>

<div id="<%= dom_id(task) %>" data-task-id="<%= task.id %>">
  <%= render "shared/card", class_name: card_class do %>
    <div class="flex items-center gap-3">
      <button
        type="button"
        class="cursor-grab select-none drag-handle"
        aria-label="Reordenar tarefa"
        data-drag-handle
      >
        <svg viewBox="0 0 24 24" role="img" aria-hidden="true" class="h-4 w-4">
          <circle cx="9" cy="6" r="1.5" fill="currentColor" />
          <circle cx="15" cy="6" r="1.5" fill="currentColor" />
          <circle cx="9" cy="12" r="1.5" fill="currentColor" />
          <circle cx="15" cy="12" r="1.5" fill="currentColor" />
          <circle cx="9" cy="18" r="1.5" fill="currentColor" />
          <circle cx="15" cy="18" r="1.5" fill="currentColor" />
        </svg>
      </button>
      <%= form_with url: toggle_list_task_path(task.list, task), method: :patch do %>
        <%= check_box_tag "done", "1", task.done?,
              class: "h-5 w-5 rounded-full border-gray-300 accent-primary",
              aria: { label: "Marcar tarefa como concluida" },
              onchange: "this.form.requestSubmit()" %>
      <% end %>

      <div class="flex-1">
        <div class="flex items-start justify-between gap-3">
          <p class="text-sm font-semibold <%= title_class %>"><%= task.title %></p>
          <% if due_label.present? %>
            <span class="<%= due_class %>"><%= due_label %></span>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <%= button_to toggle_favorite_task_path(task),
              method: :patch,
              form: { class: "inline" },
              class: "icon-button #{task.favorite? ? "icon-button--favorite" : ""}",
              aria: { label: (task.favorite? ? "Remover favorito" : "Favoritar tarefa") } do %>
          <%= render "shared/icons/star", filled: task.favorite? %>
        <% end %>
        <button type="button"
                class="icon-button"
                aria-label="Editar tarefa"
                data-action="click->task-modal#prepareEdit click->modal#open"
                data-modal-id-param="task-modal"
                data-task-id="<%= task.id %>"
                data-task-title="<%= task.title %>"
                data-task-list-id="<%= task.list_id %>"
                data-task-due-at="<%= task.due_at&.in_time_zone&.strftime("%Y-%m-%dT%H:%M") %>"
                data-task-favorite="<%= task.favorite? %>">
          <%= render "shared/icons/edit" %>
        </button>
        <%= button_to list_task_path(task.list, task),
              method: :delete,
              data: { turbo_confirm: "Tem certeza?" },
              form: { class: "inline" },
              class: "icon-button icon-button--danger",
              aria: { label: "Deletar tarefa" } do %>
          <%= render "shared/icons/trash" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
