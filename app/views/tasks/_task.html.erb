<div id="<%= dom_id(task) %>" style="margin-left: 18px;">
  <%= task.title %>

  <span style="margin-left: 10px;">
    <%= link_to "Editar", edit_list_task_path(task.list, task) %>
    <%= button_to "Deletar",
          list_task_path(task.list, task),
          method: :delete,
          data: { turbo_confirm: "Tem certeza?" } %>
  </span>
</div>
