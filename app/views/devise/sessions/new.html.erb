<% content_for :title, "Entrar" %>

<div class="w-full max-w-md">
  <div class="app-modal__panel">
    <div class="mb-6 flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-gray-200 bg-gray-50 text-[color:var(--color-primary-600)]">
        <%= render "shared/icons/logo", class_name: "h-5 w-5" %>
      </div>
      <div>
        <h1 class="text-lg font-semibold text-gray-900">Entrar</h1>
        <p class="text-sm text-gray-500">Acesse sua conta para continuar.</p>
      </div>
    </div>

    <%= form_with scope: resource_name, model: resource, url: session_path(resource_name), local: true do |form| %>
      <div class="app-modal__field">
        <%= form.label :email, "Email", class: "app-modal__label" %>
        <%= form.email_field :email,
            autofocus: true,
            autocomplete: "email",
            class: "app-modal__input",
            required: true %>
      </div>

      <div class="app-modal__field">
        <%= form.label :password, "Senha", class: "app-modal__label" %>
        <%= form.password_field :password,
            autocomplete: "current-password",
            class: "app-modal__input",
            required: true %>
      </div>

      <% if devise_mapping.rememberable? || devise_mapping.recoverable? %>
        <div class="mb-4 flex items-center justify-between gap-3">
          <% if devise_mapping.rememberable? %>
            <label class="flex items-center gap-2 text-xs font-semibold text-gray-600">
              <%= form.check_box :remember_me, class: "accent-primary" %>
              Lembrar de mim
            </label>
          <% end %>
          <% if devise_mapping.recoverable? %>
            <%= link_to "Esqueceu a senha?",
                new_user_password_path,
                class: "text-xs font-semibold text-[color:var(--color-primary-600)] hover:text-[color:var(--color-primary-700)]" %>
          <% end %>
        </div>
      <% end %>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <%= render "shared/button",
            label: "Entrar",
            variant: :primary,
            type: "submit",
            class_name: "w-full justify-center" %>
        <% if devise_mapping.registerable? %>
          <%= render "shared/button",
              label: "Criar conta",
              variant: :secondary,
              href: new_user_registration_path,
              class_name: "w-full justify-center" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
