<%
    heading_title =
        if @search_mode
            "Resultados da busca"
        elsif @filter == "today"
            "Hoje"
        elsif @filter == "soon"
            "Em breve"
        elsif @filter == "overdue"
            "Atrasados"
        elsif @filter == "favorites"
            "Favoritos"
        elsif @selected_list
            @selected_list.title
        else
            "Minhas listas"
        end

    heading_description =
        if @search_mode
            "Resultados para \"#{@q}\""
        elsif @filter == "today"
            "Tarefas com vencimento hoje."
        elsif @filter == "soon"
            "Tarefas para os proximos dias."
        elsif @filter == "overdue"
            "Tarefas atrasadas que ainda nao foram concluidas."
        elsif @filter == "favorites"
            "Tarefas marcadas como favoritas."
        elsif @selected_list
            "Tarefas desta lista."
        else
            "Organize suas tarefas em listas."
        end

    sortable = @filter.blank? && !@search_mode
%>

<div class="w-full flex flex-col gap-8 lg:flex-row">
    <%= render "shared/sidebar",
        lists: @lists,
        selected_list: @selected_list,
        filter: @filter,
        task_summary: @task_summary %>

    <section class="flex-1 space-y-6">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <h1 class="text-2xl font-semibold text-gray-900"><%= heading_title %></h1>
                <p class="mt-1 text-sm text-gray-500"><%= heading_description %></p>
            </div>
        </div>

        <div id="lists" class="space-y-4">
            <% if @search_mode %>
                <% if @display_lists.blank? %>
                    <%= render "shared/empty_state",
                        title: "Nada encontrado",
                        description: "Nenhuma lista corresponde a sua busca." %>
                <% else %>
                    <div class="space-y-3">
                        <%= render partial: "lists/list",
                            collection: @display_lists,
                            as: :list,
                            locals: { tasks_by_list_id: @tasks_by_list_id, sortable: false } %>
                    </div>
                <% end %>
            <% elsif @filter.present? %>
                <% if @display_lists.blank? %>
                    <% empty_title, empty_description = case @filter
                        when "today"
                            ["Sem tarefas para hoje", "Voce nao tem tarefas com vencimento hoje."]
                        when "soon"
                            ["Nada em breve", "Nenhuma tarefa nos proximos dias."]
                        when "overdue"
                            ["Sem atrasos", "Nenhuma tarefa vencida no momento."]
                        when "favorites"
                            ["Nenhum favorito", "Marque tarefas com estrela para aparecer aqui."]
                        else
                            ["Nenhum resultado", "Nao ha tarefas para este filtro."]
                        end %>
                    <%= render "shared/empty_state",
                        title: empty_title,
                        description: empty_description %>
                <% else %>
                    <div class="space-y-3">
                        <%= render partial: "lists/list",
                            collection: @display_lists,
                            as: :list,
                            locals: { tasks_by_list_id: @tasks_by_list_id, sortable: false } %>
                    </div>
                <% end %>
            <% elsif @selected_list %>
                <% if @selected_list.tasks.blank? %>
                    <%= render "shared/empty_state",
                        title: "Sem tarefas nesta lista",
                        description: "Adicione uma tarefa para comecar." do %>
                        <%= render "shared/button",
                            label: "Adicionar tarefa",
                            variant: :primary,
                            type: "button",
                            data: {
                                action: "click->task-modal#prepareNew click->modal#open",
                                modal_id_param: "task-modal",
                                task_list_id: @selected_list.id
                            } %>
                    <% end %>
                <% else %>
                    <div class="space-y-3">
                        <%= render partial: "lists/list",
                            collection: @display_lists,
                            as: :list,
                            locals: { tasks_by_list_id: @tasks_by_list_id, sortable: sortable } %>
                    </div>
                <% end %>
            <% elsif @lists.blank? %>
                <%= render "shared/empty_state",
                    title: "Voce ainda nao tem listas",
                    description: "Crie uma lista para organizar suas tarefas." do %>
                    <%= render "shared/button",
                        label: "Criar lista",
                        variant: :primary,
                        type: "button",
                        data: { action: "click->list-modal#prepareNew click->modal#open", modal_id_param: "list-modal" } %>
                <% end %>
            <% else %>
                <div class="space-y-3">
                    <%= render partial: "lists/list",
                        collection: @display_lists,
                        as: :list,
                        locals: { tasks_by_list_id: @tasks_by_list_id, sortable: sortable } %>
                </div>
            <% end %>
        </div>
    </section>
</div>

<%= render "lists/new_list_modal", list: @list %>
<%= render "tasks/new_task_modal", task: @task, lists: @lists %>
