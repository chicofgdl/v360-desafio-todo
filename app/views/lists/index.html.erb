<div class="w-full flex flex-col gap-8 lg:flex-row">
    <aside class="w-full lg:w-64 space-y-6">
        <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500">Filtros</h2>

            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-lg border border-gray-200 bg-white px-3 py-2">
                    <span class="text-sm font-medium text-gray-900">Todas</span>
                    <%= render "shared/badge", text: @task_summary[:total], variant: :blue %>
                </div>

                <div class="flex items-center justify-between rounded-lg border border-gray-200 bg-white px-3 py-2">
                    <span class="text-sm font-medium text-gray-900">Pendentes</span>
                    <%= render "shared/badge", text: @task_summary[:pending], variant: :yellow %>
                </div>

                <div class="flex items-center justify-between rounded-lg border border-gray-200 bg-white px-3 py-2">
                    <span class="text-sm font-medium text-gray-900">Concluidas</span>
                    <%= render "shared/badge", text: @task_summary[:done], variant: :purple %>
                </div>
            </div>
        </div>

        <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500">Minhas listas</h2>

            <div class="mt-3 space-y-2">
                <% if @lists.blank? %>
                    <p class="text-sm text-gray-500">Nenhuma lista criada.</p>
                <% else %>
                    <% @lists.each do |list| %>
                        <div class="flex items-center justify-between rounded-lg px-3 py-2 hover:bg-gray-50">
                            <span class="text-sm text-gray-900"><%= list.title %></span>
                            <%= render "shared/badge", text: list.tasks.size, variant: :neutral %>
                        </div>
                    <% end %>
                <% end %>
            </div>
        </div>
    </aside>

    <section class="flex-1 space-y-6">
        <div>
            <h1 class="text-2xl font-semibold text-gray-900">Minhas listas</h1>
            <p class="mt-1 text-sm text-gray-500">Organize suas tarefas em listas.</p>
        </div>

        <%= render "shared/card", class_name: "p-4" do %>
            <%= render "form", list: @list %>
        <% end %>

        <div id="lists" class="space-y-4">
            <% if @lists.blank? %>
                <%= render "shared/empty_state",
                    title: "Voce ainda nao tem listas",
                    description: "Crie uma lista usando o formulario acima para organizar suas tarefas." %>
            <% else %>
                <div class="space-y-3">
                    <%= render @lists %>
                </div>
            <% end %>
        </div>
    </section>
</div>
