<dialog id="list-modal" class="app-modal">
  <div class="app-modal__panel">
    <div class="app-modal__header">
      <h2>Nova lista</h2>
      <button type="button"
              class="app-modal__close"
              data-action="click->modal#close"
              data-modal-id-param="list-modal"
              aria-label="Fechar">
        x
      </button>
    </div>

    <%= form_with model: list, url: lists_path do |form| %>
      <div class="app-modal__field">
        <%= form.label :title, "Nome da lista", class: "app-modal__label" %>
        <%= form.text_field :title,
            class: "app-modal__input",
            placeholder: "Ex: Trabalho, Pessoal, Compras...",
            required: true %>
      </div>

      <div class="app-modal__field">
        <div class="app-modal__label">Cor</div>
        <div class="app-modal__swatches app-blocked" aria-disabled="true">
          <span class="app-swatch app-swatch--red"></span>
          <span class="app-swatch app-swatch--orange"></span>
          <span class="app-swatch app-swatch--yellow"></span>
          <span class="app-swatch app-swatch--green"></span>
          <span class="app-swatch app-swatch--blue"></span>
          <span class="app-swatch app-swatch--purple"></span>
          <span class="app-swatch app-swatch--pink"></span>
          <span class="app-swatch app-swatch--gray"></span>
        </div>
        <div class="app-modal__hint">Bloqueado por enquanto.</div>
      </div>

      <div class="app-modal__field">
        <div class="app-modal__label">Icone</div>
        <div class="app-modal__chips app-blocked" aria-disabled="true">
          <span class="app-chip is-active">Pasta</span>
          <span class="app-chip">Pessoal</span>
          <span class="app-chip">Trabalho</span>
          <span class="app-chip">Compras</span>
        </div>
        <div class="app-modal__hint">Bloqueado por enquanto.</div>
      </div>

      <div class="app-modal__preview app-blocked" aria-disabled="true">
        <div class="app-preview__icon">L</div>
        <div>
          <div class="app-preview__title">Nome da lista</div>
          <div class="app-preview__subtitle">Pre-visualizacao</div>
        </div>
      </div>

      <div class="app-modal__actions">
        <button type="button"
                class="btn btn--secondary"
                data-action="click->modal#close"
                data-modal-id-param="list-modal">
          Cancelar
        </button>
        <%= render "shared/button", label: "Criar lista", variant: :primary, type: "submit" %>
      </div>
    <% end %>
  </div>
</dialog>
