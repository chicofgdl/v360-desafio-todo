<div id="<%= dom_id(list) %>" style="border: 1px solid #ccc; padding: 10px; margin-bottom: 15px;">
    <strong><%= list.title %></strong>

    <span style="margin-left: 1em; display: flex; gap: 10px;">
        <%= link_to "Editar", edit_list_path(list) %> |
        <%= button_to "Deletar", list_path(list), method: :delete, data: { turbo_confirm: "Tem certeza?" } %>
    </span>

    <div style="margin-top: 8px;">
        <%= render "tasks/form", list: list, task: Task.new %>
    </div>

    <% if list.tasks.any? %>
        <div style="margin-top: 8px;">
            <%= render list.tasks %>
        </div>
    <% end %>
</div>
