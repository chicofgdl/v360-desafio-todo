<div id="<%= dom_id(list) %>">
    <%= render "shared/card", class_name: "p-4 space-y-4" do %>
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <h3 class="text-sm font-semibold text-gray-900"><%= list.title %></h3>
                <p class="text-xs text-gray-500"><%= pluralize(list.tasks.size, "tarefa") %></p>
            </div>

            <div class="flex items-center gap-2 text-xs">
                <%= link_to "Editar", edit_list_path(list), class: "text-gray-500 hover:text-gray-900" %>
                <%= button_to "Deletar",
                    list_path(list),
                    method: :delete,
                    data: { turbo_confirm: "Tem certeza?" },
                    form: { class: "inline" },
                    class: "text-red-600 hover:text-red-700" %>
            </div>
        </div>

        <% if list.tasks.blank? %>
            <%= render "shared/empty_state",
                title: "Lista vazia",
                description: "Adicione uma tarefa para comecar." do %>
                <%= render "shared/button",
                    label: "Adicionar tarefa",
                    variant: :secondary,
                    type: "button",
                    data: { action: "click->modal#open", modal_id_param: "task-modal" } %>
            <% end %>
        <% else %>
            <div class="space-y-2">
                <%= render list.tasks %>
            </div>

            <div class="pt-2">
                <%= render "shared/button",
                    label: "+ Adicionar tarefa",
                    variant: :tertiary,
                    class_name: "text-xs",
                    type: "button",
                    data: { action: "click->modal#open", modal_id_param: "task-modal" } %>
            </div>
        <% end %>
    <% end %>
</div>
