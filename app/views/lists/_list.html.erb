<%
    tasks = if local_assigns[:tasks_by_list_id].present?
        local_assigns[:tasks_by_list_id].fetch(list.id, [])
    else
        list.tasks
    end
    sortable = local_assigns.fetch(:sortable, true)
    show_suggestions = local_assigns.fetch(:show_suggestions, true)
%>

<div id="<%= dom_id(list) %>">
    <%= render "shared/card", class_name: "p-4 space-y-4" do %>
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <h3 class="text-sm font-semibold text-gray-900"><%= list.title %></h3>
                <p class="text-xs text-gray-500"><%= pluralize(tasks.size, "tarefa") %></p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <% if show_suggestions %>
                    <%= button_to task_suggestions_list_path(list),
                        method: :post,
                        form: {
                            class: "inline",
                            data: {
                                controller: "task-suggestions",
                                action: "turbo:submit-start->task-suggestions#start turbo:submit-end->task-suggestions#end"
                            }
                        },
                        class: "btn btn--secondary text-xs",
                        data: { task_suggestions_target: "button" },
                        aria: { label: "Sugerir tasks" } do %>
                        <span data-task-suggestions-target="icon" class="inline-flex">
                            <%= render "shared/icons/sparkles", class_name: "h-4 w-4" %>
                        </span>
                        <span data-task-suggestions-target="spinner" class="hidden">
                            <%= render "shared/icons/spinner", class_name: "h-4 w-4 animate-spin" %>
                        </span>
                        <span data-task-suggestions-target="label">Sugerir tasks</span>
                    <% end %>
                <% end %>
                <button type="button"
                        class="icon-button"
                        aria-label="Editar lista"
                        data-action="click->list-modal#prepareEdit click->modal#open"
                        data-modal-id-param="list-modal"
                        data-list-id="<%= list.id %>"
                        data-list-title="<%= list.title %>">
                    <%= render "shared/icons/edit" %>
                </button>
                <%= button_to list_path(list),
                    method: :delete,
                    data: { turbo_confirm: "Tem certeza?" },
                    form: { class: "inline" },
                    class: "icon-button icon-button--danger",
                    aria: { label: "Deletar lista" } do %>
                    <%= render "shared/icons/trash" %>
                <% end %>
            </div>
        </div>

        <% if tasks.blank? %>
            <%= render "shared/empty_state",
                title: "Lista vazia",
                description: "Adicione uma tarefa para comecar." do %>
                <%= render "shared/button",
                    label: "Adicionar tarefa",
                    variant: :secondary,
                    type: "button",
                    data: {
                        action: "click->task-modal#prepareNew click->modal#open",
                        modal_id_param: "task-modal",
                        task_list_id: list.id
                    } %>
            <% end %>
        <% else %>
            <% if sortable %>
                <div
                    class="space-y-2"
                    data-controller="sortable"
                    data-sortable-url-value="<%= reorder_list_tasks_path(list) %>"
                >
                    <%= render tasks %>
                </div>
            <% else %>
                <div class="space-y-2">
                    <%= render tasks %>
                </div>
            <% end %>

            <div class="pt-2">
                <%= render "shared/button",
                    label: "+ Adicionar tarefa",
                    variant: :tertiary,
                    class_name: "text-xs",
                    type: "button",
                    data: {
                        action: "click->task-modal#prepareNew click->modal#open",
                        modal_id_param: "task-modal",
                        task_list_id: list.id
                    } %>
            </div>
        <% end %>
    <% end %>
</div>
