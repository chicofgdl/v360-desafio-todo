# Apenas para ambientes de desenvolvimento e teste.
#
# Chave da api do OpenAI.
OPENAI_API_KEY=

# Ativar modo mock para sugestões de IA (true/false).
AI_SUGGEST_MOCK=false

# Configurações opcionais (padrões mostrados).
AI_SUGGEST_MODEL=gpt-4o-mini
AI_SUGGEST_TEMPERATURE=0.4
AI_SUGGEST_MAX=8
AI_SUGGEST_CONTEXT_MAX=30
AI_SUGGEST_TIMEOUT=10
